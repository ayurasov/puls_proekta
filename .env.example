# Пульс Проекта — переменные окружения Docker Compose. Скопируйте в .env и заполните.

# Пароль PostgreSQL (любой длинный случайный, например: openssl rand -hex 24)
POSTGRES_USER=puls
POSTGRES_DB=puls
POSTGRES_PASSWORD=

# Секрет подписи (не короче 32 символов): openssl rand -hex 32
SECRET_KEY=

# Порт, на котором открывается система (как у версии 1.0.x)
HTTP_PORT=39663
HTTP_BIND=0.0.0.0

# true — только при доступе по HTTPS (через обратный прокси с сертификатом)
SESSION_COOKIE_SECURE=false
SESSION_LIFETIME_DAYS=30
LOGIN_RATE_LIMIT=10 per minute;50 per hour

# Автоснимки планов не чаще раза в N минут редактирования
SNAPSHOT_INTERVAL_MINUTES=30

# Только для новой установки без переноса данных 1.0.x: пароль первого администратора (логин admin)
BOOTSTRAP_ADMIN_PASSWORD=

# Резервные копии: каталог на сервере, час ежедневной копии, срок хранения (дней)
BACKUP_DIR=./backups
BACKUP_HOUR=03
BACKUP_RETENTION_DAYS=30

TZ=Europe/Moscow
# Процессов backend; пусто — 2 × число ядер + 1 (не больше 9)
GUNICORN_WORKERS=
# Журнал запросов backend (docker compose logs backend)
ACCESS_LOG=false
