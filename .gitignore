backend/**/__pycache__
backend/.pytest_cache/
backend/*.db
backend/instance/
*.pyc

# Local data (production database never goes to git from a server)
/data/
/backups/
*.dump

# Temporary HTML of the manuals build (tools/docs/build_manuals.py)
docs/**/*.build.html
/import/*
!/import/README.md
