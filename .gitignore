# Dependencies and builds
node_modules
dist
dist-ssr
*.local

# Local configuration and secrets
.env
.env.*
!.env.example
# Настройки конкретного сервера (например, подсеть Docker) — см. руководство по установке
docker-compose.override.yml

# Test artifacts
test-results/
playwright-report/
coverage/

# Editors
.vscode/*
